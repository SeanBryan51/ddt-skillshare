#!/bin/bash
#PBS -N ddt-demo
#PBS -l wd
#PBS -P tm70
#PBS -q normal
#PBS -l walltime=2:00:00  
#PBS -l ncpus=4
#PBS -l mem=8GB
#PBS -l storage=gdata/tm70

rm -f ddt_log.txt ddt_debug.html
module load linaro-forge/24.0.2
module load intel-mpi/2021.13.1
ddt --offline -o ddt_debug.html --mem-debug=balanced --debug --log=ddt_log.txt mpirun -n $PBS_NCPUS ./integrate_mpi

